# JonoSeba application configuration
APP_NAME="JonoSeba API"
APP_VERSION="0.1.0"
API_V1_PREFIX="/api/v1"
DEBUG=false

JWT_SECRET_KEY=replace-with-a-secure-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
 
# Google Gemini AI
GEMINI_API_KEY=
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=800
# Additional application settings
DATABASE_URL=postgresql+asyncpg://jonoseba:replace-with-db-password@localhost:5432/jonoseba_db
APP_DESCRIPTION=AI-Powered Smart Citizen Services and Complaint Management Platform.
